{
  "pipeline": "deseq2",
  "version": "1.38.0",
  "parameters": {
    "significance_threshold": 0.01,
    "log2fc_cutoff": 1.0,
    "multiple_testing_correction": "BH",
    "exclude_samples": ["S07"],
    "covariates": ["batch", "sex", "age"],
    "normalization": "median_of_ratios"
  },
  "optimizations": {
    "parallel_threads": 8,
    "cache_intermediate": true,
    "compress_output": true
  },
  "notes": "Final optimized configuration from submission_6"
}
