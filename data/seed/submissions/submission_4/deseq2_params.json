{
  "analysis": {
    "method": "DESeq2",
    "version": "1.42.0",
    "design_formula": "~ treatment + batch + sex",
    "reduced_formula": "~ batch + sex",
    "test": "LRT",
    "fit_type": "parametric"
  },
  "filtering": {
    "min_count": 10,
    "min_samples": 3,
    "independent_filtering": true,
    "cook_cutoff": 0.99,
    "genes_removed": 1523,
    "genes_retained": 2847
  },
  "normalization": {
    "method": "median_of_ratios",
    "size_factors": {
      "S01": 1.05, "S02": 0.98, "S03": 1.12,
      "S04": 0.95, "S05": 1.03, "S06": 0.97,
      "S07": 0.72, "S08": 1.08, "S09": 1.01,
      "S10": 0.93, "S11": 1.15, "S12": 0.99
    }
  },
  "thresholds": {
    "significance": 0.05,
    "log2fc": 1.0,
    "correction": "BH"
  },
  "contrasts": [
    {
      "name": "treatment_vs_control",
      "numerator": "treatment",
      "denominator": "control",
      "significant_up": 412,
      "significant_down": 435
    }
  ],
  "output": {
    "results_table": "deg_results.csv",
    "volcano_plot": "fig_volcano_enhanced.png",
    "heatmap": "fig_heatmap_clustered.png",
    "ma_plot": "fig_ma_plot.png"
  }
}
